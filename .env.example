# Ollama (local, free) — copy to .env and adjust if needed
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_EMBED_MODEL=nomic-embed-text

# RAG app
RAG_INDEX_PATH=data/index.json
RAG_TOP_K=5
RAG_REFUSAL_THRESHOLD=0.25

# Set to 1 to run the app with deterministic fake embeddings (no Ollama)
RAG_FAKE_LLM=0

# Fusion strategy for hybrid search: linear or rrf
RAG_FUSION=linear
# Set to 1 to rerank retrieved chunks before answering
RAG_RERANK=0
# JSONL query log for /ask (empty value disables); logs every question,
# its best score, and whether it was refused
RAG_QUERY_LOG=logs/queries.jsonl
